  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>set model-version "sheep-wolves-grass"
set show-energy? false
setup
repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="experiment_400_400" repetitions="3" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1500">
      <setup>set initial-number-sheep 400
set initial-number-wolves 400
setup</setup>
      <go>go</go>
      <exitCondition>(land_with_grass = 0) or (not any? turtles)</exitCondition>
      <metrics>
        <metric>land_with_grass</metric>
        <metric>count sheep</metric>
        <metric>count wolves</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="wolf-reproduce-probability" first="4" step="2" last="20"></steppedValueSet>
        <steppedValueSet variable="sheep-reproduce-probability" first="4" step="2" last="20"></steppedValueSet>
        <steppedValueSet variable="grass-regrowth-time" first="150" step="25" last="250"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="experiment_100_100" repetitions="3" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1500">
      <setup>set initial-number-sheep 100
set initial-number-wolves 100
setup</setup>
      <go>go</go>
      <exitCondition>(land_with_grass = 0) or (not any? turtles)</exitCondition>
      <metrics>
        <metric>land_with_grass</metric>
        <metric>count sheep</metric>
        <metric>count wolves</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="wolf-reproduce-probability" first="4" step="2" last="20"></steppedValueSet>
        <steppedValueSet variable="sheep-reproduce-probability" first="4" step="2" last="20"></steppedValueSet>
        <steppedValueSet variable="grass-regrowth-time" first="150" step="25" last="250"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
