    <slider x="258" step="2" y="22" max="20" display="initial-number-wolves" height="50" min="0" direction="Horizontal" default="20.0" variable="initial-number-wolves" width="165" sizeVersion="0"></slider>
    <slider x="149" step="25" y="79" max="200" display="grass-regrowth-time" height="50" min="0" direction="Horizontal" default="200.0" variable="grass-regrowth-time" width="212" sizeVersion="0"></slider>
