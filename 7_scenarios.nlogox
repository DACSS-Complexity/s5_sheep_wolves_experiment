<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  initial_grass
  current_grass
  sheep-gain-from-food
  wolf-gain-from-food
]

; Shared animal state.
turtles-own [ energy ]

; Sheep and wolves are breeds of turtles.
breed [ sheep a-sheep ]
breed [ wolves wolf ]


; Grass state is represented on patches.
patches-own [
  food-available?
  countdown
]

to setup
  clear-all

  ; Initialize food gains independently of animal populations.
  set sheep-gain-from-food 4
  set wolf-gain-from-food sheep-gain-from-food * 5

  ; Set up grass.
  ask patches [
    set food-available? false
    set pcolor brown
  ]

  let total-patches count patches
  set initial_grass floor (total-patches / 2)

  ask n-of initial_grass patches [
    set food-available? true
    set pcolor green
  ]

  ask patches with [food-available?] [
    set countdown grass-regrowth-time
  ]

  ask patches with [not food-available?] [
    set countdown random grass-regrowth-time
  ]

  set current_grass count patches with [food-available?]

  ; Set up sheep.
  create-sheep initial-number-sheep [
    set shape "sheep"
    set color white
    set size 1.5
    set energy random sheep-gain-from-food
    setxy random-xcor random-ycor
  ]

  ; Set up wolves.
  create-wolves initial-number-wolves [
    set shape "wolf"
    set color black
    set size 2
    set energy random wolf-gain-from-food
    setxy random-xcor random-ycor
  ]

  reset-ticks
end

to go
  ; Stop when both animal populations are extinct.
  if not any? turtles [ stop ]

  ask sheep [
    wander
    lose-energy
    eat-grass
    die-if-starving
    reproduce sheep-reproduce-probability
  ]

  ask wolves [
    wander
    lose-energy
    eat-sheep
    die-if-starving
    reproduce wolf-reproduce-probability
  ]

  ask patches [
    regrow-grass
  ]

  set current_grass count patches with [food-available?]
  tick
end

; Shared animal capabilities.
to wander
  rt random 360
  fd 1
end

to lose-energy
  set energy energy - 1
end

to die-if-starving
  ; Animals with zero energy survive this check.
  if energy < 0 [ die ]
end

to reproduce [ reproduction-probability ]
  ; Probability is expressed as a percentage from 0 to 100.
  if random-float 100 < reproduction-probability [
    set energy energy / 2

    ; Offspring inherit the parent's breed and halved energy.
    hatch 1 [
      rt random-float 360
      fd 1
    ]
  ]
end

; Sheep-specific capability.
to eat-grass
  if food-available? [
    set food-available? false
    set pcolor brown
    set energy energy + sheep-gain-from-food
  ]
end

; Wolf-specific capability.
to eat-sheep
  let prey one-of sheep-here

  if prey != nobody [
    ask prey [ die ]
    set energy energy + wolf-gain-from-food
  ]
end

; Grass capability, executed by patches.
to regrow-grass
  if not food-available? [
    ifelse countdown <= 0 [
      set food-available? true
      set pcolor green
      set countdown grass-regrowth-time
    ] [
      set countdown countdown - 1
    ]
  ]
end

; Percentage of patches with available grass.
to-report land_with_grass
  report 100 * count patches with [food-available?] / count patches
end

; Copyright 1997 Uri Wilensky.
; See Info tab for full copyright and license.]]></code>
